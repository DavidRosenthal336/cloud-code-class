# Anthropic API key for memo generation. Required for AI memo feature.
ANTHROPIC_API_KEY=

# Password gate. If empty, the app is open (no login screen). Set this in
# production so only authorized users can access /api/generate-memo.
APP_PASSWORD=

# Random string used to sign session cookies. Required in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Optional: override port for the dev/prod server (default 3001)
PORT=3001
